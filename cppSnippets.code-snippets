            "            if (s[i - 1] == t[j - 1]) {",
            "                ans += s[i - 1];",
            "                --i; --j;",
            "            } else if (dp[i - 1][j] > dp[i][j - 1]) {",
            "                --i;",
            "            } else {",
            "                --j;",
