            "bool in_stack[N];",
            "vector<int> st;",
            "vector<vector<int>> sccs;",
            "int comp[N], scc_cnt;",
            "",
            "void tarjan_dfs(int u) {",
            "    tin[u] = low[u] = ++timer;",
            "    st.push_back(u);",
            "    in_stack[u] = true;",
            "",
            "    for (int v : g[u]) {",
            "        if (!tin[v]) {",
            "            tarjan_dfs(v);",
            "            low[u] = min(low[u], low[v]);",
            "        } else if (in_stack[v]) {",
            "            low[u] = min(low[u], tin[v]);",
            "        }",
            "    }",
            "",
            "    if (low[u] == tin[u]) {",
            "        sccs.push_back({});",
            "        scc_cnt++;",
            "        while (true) {",
            "            int v = st.back();",
            "            st.pop_back();",
            "            in_stack[v] = false;",
            "            comp[v] = scc_cnt;",
            "            sccs.back().push_back(v);",
            "            if (u == v) break;",
            "        }",
            "    }",
            "}",
            "",
            "void find_sccs(int n) {",
            "    timer = scc_cnt = 0;",
