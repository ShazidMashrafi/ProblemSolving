            "const long long INF = 1e18;",
            "",
            "struct Edge {",
            "    int u, v;",
            "    long long w;",
            "};",
            "",
            "long long dist[N];",
            "",
            "// Returns true if a negative cycle is reachable from src",
            "bool bellman_ford(int src, int n, const vector<Edge>& edges) {",
            "    fill(dist, dist + n + 1, INF);",
            "    dist[src] = 0;",
            "",
            "    for (int i = 1; i <= n - 1; ++i) {",
            "        for (const auto& [u, v, w] : edges) {",
            "            if (dist[u] < INF && dist[u] + w < dist[v]) {",
            "                dist[v] = dist[u] + w;",
            "            }",
            "        }",
            "    }",
            "",
            "    for (const auto& [u, v, w] : edges) {",
            "        if (dist[u] < INF && dist[u] + w < dist[v]) {",
            "            return true;",
            "        }",
            "    }",
            "    return false;",
            "}"
        ]
    },
    "bfs": {
        "prefix": "bfs",
        "scope": "cpp",
        "description": "[graphs] bfs",
        "body": [
            "const int N = 1e5 + 10;",
            "vector<int> g[N];",
            "int dist[N], parent[N];",
            "",
            "void bfs(int src, int n) {",
            "    fill(dist, dist + n + 1, -1);",
            "    queue<int> q;",
            "    dist[src] = 0;",
            "    parent[src] = -1;",
            "    q.push(src);",
            "",
            "    while (!q.empty()) {",
            "        int u = q.front();",
            "        q.pop();",
            "        for (int v : g[u]) {",
            "            if (dist[v] == -1) {",
            "                dist[v] = dist[u] + 1;",
            "                parent[v] = u;",
            "                q.push(v);",
            "            }",
            "        }",
            "    }",
            "}",
            "",
            "vector<int> get_path(int target) {",
            "    if (dist[target] == -1) return {};",
            "    vector<int> path;",
            "    for (int v = target; v != -1; v = parent[v]) path.push_back(v);",
            "    reverse(path.begin(), path.end());",
            "    return path;",
            "}"
        ]
    },
