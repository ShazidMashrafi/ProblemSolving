    "dijkstra": {
        "prefix": "dijkstra",
        "scope": "cpp",
        "description": "[graphs] dijkstra",
        "body": [
            "struct Dijkstra {",
            "    ll INF = 1e18;",
            "    vector<ll> dist;",
            "    vector<int> par;",
            "",
            "    Dijkstra(int n, int src, auto& g) : dist(n + 1, INF), par(n + 1, -1) {",
            "        priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<>> pq;",
            "        dist[src] = 0;",
            "        pq.push({0, src});",
            "",
            "        while (!pq.empty()) {",
            "            auto [d, u] = pq.top();",
            "            pq.pop();",
            "            if (d > dist[u]) continue;",
            "",
            "            for (auto [v, w] : g[u]) {",
            "                if (dist[u] + w < dist[v]) {",
            "                    dist[v] = dist[u] + w;",
            "                    par[v] = u;",
            "                    pq.push({dist[v], v});",
            "                }",
            "            }",
            "        }",
            "    }",
            "",
            "    vector<int> get_path(int target) {",
            "        if (dist[target] == INF) return {};",
            "        vector<int> path;",
            "        for (int v = target; v != -1; v = par[v]) path.push_back(v);",
            "        reverse(path.begin(), path.end());",
            "        return path;",
            "    }",
            "};"
        ]
    },
    "dsu": {
        "prefix": "dsu",
        "scope": "cpp",
        "description": "[data-structures] dsu",
        "body": [
            "struct DSU {",
            "    vector<int> par, siz;",
            "    int comps;",
            "",
            "    DSU(int n) {",
            "        par.resize(n + 1);",
            "        iota(par.begin(), par.end(), 0);",
            "        siz.assign(n + 1, 1);",
            "        comps = n;",
            "    }",
            "",
            "    int find(int u) {",
            "        return par[u] == u ? u : par[u] = find(par[u]);",
            "    }",
            "",
            "    bool same(int u, int v) {",
            "        return find(u) == find(v);",
            "    }",
            "",
            "    bool unite(int u, int v) {",
            "        u = find(u); v = find(v);",
            "        if (u == v) return false;",
            "        if (siz[u] < siz[v]) swap(u, v);",
            "        par[v] = u;",
            "        siz[u] += siz[v];",
            "        comps--;",
            "        return true;",
            "    }",
            "",
            "    int size(int u) {",
            "        return siz[find(u)];",
            "    }",
            "};"
        ]
    },
