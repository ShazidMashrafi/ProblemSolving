            "    Topo(int n, auto& g) {",
            "        vector<int> in(n + 1, 0);",
            "        for (int u = 1; u <= n; ++u) {",
            "            for (int v : g[u]) in[v]++;",
            "        }",
            "",
            "        queue<int> q;",
            "        for (int i = 1; i <= n; ++i) {",
            "            if (in[i] == 0) q.push(i);",
