            "    }",
            "    vis[u] = 2;",
            "    return false;",
            "}",
            "",
            "bool has_cycle(int n) {",
            "    fill(vis, vis + n + 1, 0);",
            "    for (int i = 1; i <= n; ++i) {",
            "        if (!vis[i] && dfs_cycle(i, 0)) return true;",
            "    }",
            "    return false;",
            "}"
        ]
