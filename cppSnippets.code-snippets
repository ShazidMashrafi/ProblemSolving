    "combinatorics": {
        "prefix": "combinatorics",
        "scope": "cpp",
        "description": "[maths] combinatorics",
        "body": [
            "// requires binpow(base, exp, mod)",
            "struct Comb {",
            "    int n, mod;",
            "    vector<ll> fact, inv;",
            "",
            "    Comb(int n = 1e6 + 5, int mod = 1e9 + 7) : n(n), mod(mod), fact(n), inv(n) {",
            "        fact[0] = inv[0] = 1;",
            "        for (int i = 1; i < n; ++i) fact[i] = fact[i - 1] * i % mod;",
            "        inv[n - 1] = binpow(fact[n - 1], mod - 2, mod);",
            "        for (int i = n - 2; i >= 1; --i) inv[i] = inv[i + 1] * (i + 1) % mod;",
            "    }",
            "",
            "    ll nCr(int n, int r) {",
            "        if (r < 0 || r > n) return 0;",
            "        return fact[n] * inv[r] % mod * inv[n - r] % mod;",
            "    }",
            "",
            "    ll nPr(int n, int r) {",
            "        if (r < 0 || r > n) return 0;",
            "        return fact[n] * inv[n - r] % mod;",
            "    }",
            "};"
        ]
    },
    "convex_hull": {
        "prefix": "convex_hull",
        "scope": "cpp",
        "description": "[geometry] convex_hull",
        "body": [
            "struct Point {",
            "    ll x, y;",
            "    bool operator<(Point o) const { return x == o.x ? y < o.y : x < o.x; }",
            "    bool operator==(Point o) const { return x == o.x && y == o.y; }",
            "};",
            "",
            "ll cross(Point a, Point b, Point c) {",
            "    return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);",
            "}",
            "",
            "struct Hull {",
            "    vector<Point> h;",
            "",
            "    Hull(auto pts) { // Monotone Chain",
            "        int n = pts.size(), k = 0;",
            "        if (n <= 2) { h = pts; return; }",
            "        h.resize(2 * n);",
            "        sort(pts.begin(), pts.end());",
            "        pts.erase(unique(pts.begin(), pts.end()), pts.end());",
            "        n = pts.size();",
            "",
            "        for (int i = 0; i < n; ++i) {",
            "            while (k >= 2 && cross(h[k - 2], h[k - 1], pts[i]) <= 0) k--;",
            "            h[k++] = pts[i];",
            "        }",
            "        for (int i = n - 2, t = k + 1; i >= 0; --i) {",
            "            while (k >= t && cross(h[k - 2], h[k - 1], pts[i]) <= 0) k--;",
            "            h[k++] = pts[i];",
            "        }",
            "        h.resize(k - 1);",
            "    }",
            "};"
        ]
    },
