            "        while (!q.empty()) {",
            "            int u = q.front();",
            "            q.pop();",
            "            order.push_back(u);",
            "",
            "            for (int v : g[u]) {",
            "                if (--in[v] == 0) q.push(v);",
            "            }",
            "        }",
            "",
            "        if ((int)order.size() < n) dag = false;",
            "    }",
            "};"
        ]
