            "        ms = \"^#\";",
            "        for (char c : s) { ms += c; ms += '#'; }",
            "        ms += '$';",
            "        n = ms.size();",
            "        p.assign(n, 0);",
            "        int l = 1, r = 1;",
            "        for (int i = 1; i < n - 1; i++) {",
