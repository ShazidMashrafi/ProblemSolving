            "            while (ms[i - p[i]] == ms[i + p[i]]) p[i]++;",
            "            if (i + p[i] > r) { l = i - p[i]; r = i + p[i]; }",
            "        }",
            "    }",
            "",
            "    // 0-indexed [l, r]",
